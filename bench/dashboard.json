{
  "uid": "bench-overview",
  "title": "bench",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "timezone": "browser",
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "grafanacloud-paulintodev-prom",
          "value": "grafanacloud-prom"
        },
        "hide": 0
      },
      {
        "name": "test",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(up{job=\"target\"}, test)",
        "multi": true,
        "includeAll": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "These panels use Prometheus's own metric names directly, unrenamed. Every series carries a `test` label naming which test produced it -- pick one or more in the **test** dropdown above to see them as separately coloured, legend-named lines on the same graph, no hovering required."
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "CPU usage",
      "description": "process_cpu_seconds_total, both jobs -- if avalanche rivals target, the load generator is the bottleneck, not what you're testing.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 6,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "rate(process_cpu_seconds_total{job=~\"target|avalanche\", test=~\"$test\", test!=\"\"}[$__rate_interval])",
          "legendFormat": "{{job}} / {{test}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Memory (RSS)",
      "description": "process_resident_memory_bytes{job=\"target\"}",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 6,
        "y": 3,
        "w": 6,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "process_resident_memory_bytes{job=\"target\", test=~\"$test\", test!=\"\"}",
          "legendFormat": "{{test}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Heap in use",
      "description": "go_memstats_heap_inuse_bytes{job=\"target\"}",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 3,
        "w": 6,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "go_memstats_heap_inuse_bytes{job=\"target\", test=~\"$test\", test!=\"\"}",
          "legendFormat": "{{test}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Goroutines",
      "description": "go_goroutines{job=\"target\"}",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 18,
        "y": 3,
        "w": 6,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "go_goroutines{job=\"target\", test=~\"$test\", test!=\"\"}",
          "legendFormat": "{{test}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Head series",
      "description": "prometheus_tsdb_head_series{job=\"target\"} -- should track avalanche's metrics x series regardless of which test is running.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 6,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "prometheus_tsdb_head_series{job=\"target\", test=~\"$test\", test!=\"\"}",
          "legendFormat": "{{test}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Samples ingested/sec",
      "description": "sum(rate(prometheus_tsdb_head_samples_appended_total{job=\"target\"}[$__rate_interval])) by (test) -- this counter has a `type` label (float vs histogram) that isn't part of the comparison, so it's summed away rather than left to render as two identically-legended lines per test.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 6,
        "y": 11,
        "w": 6,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (test) (rate(prometheus_tsdb_head_samples_appended_total{job=\"target\", test=~\"$test\", test!=\"\"}[$__rate_interval]))",
          "legendFormat": "{{test}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Remote write: samples/sec",
      "description": "Empty unless the test's prometheus.yml configures a remote_write block -- neither of the two shipped tests does.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 11,
        "w": 6,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "rate(prometheus_remote_storage_samples_total{job=\"target\", test=~\"$test\", test!=\"\"}[$__rate_interval])",
          "legendFormat": "{{test}} sent"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "rate(prometheus_remote_storage_samples_failed_total{job=\"target\", test=~\"$test\", test!=\"\"}[$__rate_interval])",
          "legendFormat": "{{test}} failed"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "rate(prometheus_remote_storage_samples_retried_total{job=\"target\", test=~\"$test\", test!=\"\"}[$__rate_interval])",
          "legendFormat": "{{test}} retried"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Remote write: shards",
      "description": "prometheus_remote_storage_shards{job=\"target\"} -- same caveat as the samples/sec panel.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 18,
        "y": 11,
        "w": 6,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "prometheus_remote_storage_shards{job=\"target\", test=~\"$test\", test!=\"\"}",
          "legendFormat": "{{test}}"
        }
      ]
    }
  ]
}
