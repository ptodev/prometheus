// Generated by bench for the {{printf "%q" .Label}} test. Do not edit; edit tests/common.yml.

// The target's own metrics: it remote_writes to this local, unauthenticated
// receiver (see checkTargetConfig), which forwards on to the real
// Prometheus below with the real credentials.
prometheus.receive_http "target_metrics" {
	http {
		listen_address = {{printf "%q" .ReceiveHost}}
		listen_port    = {{.ReceivePort}}
	}
	forward_to = [prometheus.remote_write.default.receiver]
}

// The target's own health: scraped like any other target (see above for
// why this isn't a self-scrape) and remote-written to Prometheus.
prometheus.scrape "target" {
	targets = [{
		"__address__" = {{printf "%q" .TargetAddr}},
	}]
	forward_to = [prometheus.remote_write.default.receiver]
	job_name   = "target"
}

// Profiles: pull CPU and memory profiles from the target's own
// /debug/pprof and forward to Pyroscope.
pyroscope.scrape "target" {
	targets = [{
		"__address__"  = {{printf "%q" .TargetAddr}},
		"service_name" = {{printf "%q" .Label}},
	}]
	forward_to = [pyroscope.write.default.receiver]

	profiling_config {
		profile.process_cpu { enabled = true }
		profile.memory      { enabled = true }
		profile.goroutine   { enabled = false }
		profile.block       { enabled = false }
		profile.mutex       { enabled = false }
	}
}

pyroscope.write "default" {
	endpoint {
		url = {{printf "%q" .Pyroscope.URL}}
{{- if and .Pyroscope.User .Pyroscope.APIKey}}
		basic_auth {
			username = {{printf "%q" .Pyroscope.User}}
			password = {{printf "%q" .Pyroscope.APIKey}}
		}
{{- end}}
	}
}

// Logs: tail the target's own log file and forward to Loki.
local.file_match "target_logs" {
	path_targets = [{
		"__path__" = {{printf "%q" .TargetLogPath}},
		"job"      = "target",
		"run"      = {{printf "%q" .Label}},
	}]
}

loki.source.file "target_logs" {
	targets    = local.file_match.target_logs.targets
	forward_to = [loki.write.default.receiver]
}

loki.write "default" {
	endpoint {
		url = {{printf "%q" .Loki.URL}}
{{- if and .Loki.User .Loki.APIKey}}
		basic_auth {
			username = {{printf "%q" .Loki.User}}
			password = {{printf "%q" .Loki.APIKey}}
		}
{{- end}}
	}
}

// Host metrics: node_exporter runs in-process, scraped like any other
// target and remote-written to Prometheus.
prometheus.exporter.unix "host" { }

prometheus.scrape "host" {
	targets    = prometheus.exporter.unix.host.targets
	forward_to = [prometheus.remote_write.default.receiver]
	job_name   = "host"
}

prometheus.remote_write "default" {
	external_labels = {
		"test" = {{printf "%q" .Label}},
	}
	endpoint {
		url = {{printf "%q" .Prometheus.URL}}
{{- if and .Prometheus.User .Prometheus.APIKey}}
		basic_auth {
			username = {{printf "%q" .Prometheus.User}}
			password = {{printf "%q" .Prometheus.APIKey}}
		}
{{- end}}
	}
}
