# Copy to common.yml and fill in the binary and monitoring endpoints.
subject_under_test:
  binary_path: /tmp/prometheus

duration: 60m

metric_scrape_load:
  active_series: 1000000

# user and api_key are optional Basic Auth credentials.
monitoring:
  prometheus:
    # Use http://127.0.0.1:9099/receive to discard remote-write data locally.
    url: https://prometheus-prod-NN-REGION.grafana.net/api/prom/push
    user: "123456"
    api_key: glc_...
  loki:
    url: https://logs-prod-REGION.grafana.net/loki/api/v1/push
    user: "123456"
    api_key: glc_...
  pyroscope:
    url: https://profiles-prod-REGION.grafana.net
    user: "123456"
    api_key: glc_...
